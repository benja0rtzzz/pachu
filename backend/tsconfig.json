{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "types": ["bun"],
    "allowImportingTsExtensions": false,
    "noEmit": false
  },
  "include": ["src/**/*"]
}
