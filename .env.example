# Copy this file to .env (in this same repo root) and edit values as needed.
# The .env file is gitignored; this template is committed so the team has a starting point.
# The backend's config loader walks up from src/env.ts to find this file, so the working
# directory does not matter — `bun test` from the root or from backend/ both work.

# --- Local LLM (Ollama) -----------------------------------------------------
# HTTP base URL for the Ollama daemon (`ollama serve`).
OLLAMA_URL=http://localhost:11434

# Model tag. Must be pulled first with `ollama pull <model>`.
# Locked default: gemma4:e2b — 7.2GB Effective 2B, fastest viable model for the live
# demo. Other models we've evaluated:
#   gemma4:e2b      7.2GB  CURRENT DEFAULT — fast, sufficient for our prompts
#   gemma4:e4b      9.6GB  more headroom, slightly better generation quality
#   gemma4:26b      18GB   strong but too slow for live demo on M-series
#   qwen3.5:9b      6.6GB  alternative, good multilingual
OLLAMA_MODEL=gemma4:e2b

# Generation timeout in milliseconds. First call after model load takes longer.
OLLAMA_TIMEOUT_MS=120000

# --- Backend server ---------------------------------------------------------
PORT=4000
HOST=0.0.0.0

# Where SQLite + other data files live (relative to backend/).
PACHU_DATA_DIR=./data

# --- FSRS tuning ------------------------------------------------------------
# Stability threshold (in days) above which Cloze switches to generated mode.
FSRS_STABILITY_DAYS=7

# --- Debug ------------------------------------------------------------------
# Set LLM_DEBUG=1 to log raw Ollama responses when content is empty.
# LLM_DEBUG=1
